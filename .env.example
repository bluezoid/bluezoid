# MongoDB — remember to percent-encode special characters in the password (@ -> %40)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=bluezoid

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Admin auth (protects /admin and /api/admin/*)
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=

# Brevo (Sendinblue) - SERVER ONLY, never use NEXT_PUBLIC_
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_ADMIN_EMAIL=
